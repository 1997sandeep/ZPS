      ZboqVersion   = zboq_version;
      ZboqHeadNo    = zboq_head_no;
      ZboqItemNo    = zboq_item_no;
      ZboqFrom      = zboq_from;
      ZboqTo        = zboq_to;
      ZboqLevel     = zboq_level;
      ZboqQty       = zboq_Qty;
      Zunit         = zunit;
      Posid         = posid;
      Zcurr         = zcurr;
      ZdesChainFrom = zdes_chain_from;
      ZdesChainTo   = zdes_chain_to;
      ZdesChainAt   = zdes_chain_at;
      ZboqHeadDesc  = zboq_head_desc;
      ZboqItemDesc  = zboq_item_desc;
      ZboqRate      = zboq_rate;
      ZtotalAmt     = ztotal_amt;
      ZProjext      = zproj_ext;
      Material      = material;
      ZboqHeadWbs   = zboq_head_wbs;
      ZboqVqty      = zboq_vqty;
      ZboqVamount   = zboq_vamount;
      ZboqVrate     = zboq_vrate;
      ZboqTqty      = zboq_tqty;
      ZboqTamount   = zboq_tamount;
      ZboqTrate     = zboq_trate;
      ZboqBlqty     = zboq_blqty;
      ZboqBlamount  = zboq_blamount;
      ZboqBlrate    = zboq_blrate;
      ZboqBill      = zboq_bill;
