unmanaged implementation in class zbp_pscds_boqroot1 unique;
strict ( 1 );
//with draft;

define behavior for ZPSCDS_BOQROOT1 alias zboqroot1
//persistent table zpst_boq_mast2
//early numbering
//draft table zpst_boq_mast2
lock master
authorization master ( instance )
//etag master <field_name>
{
  field ( mandatory )

  Zpspnr,
  Zboqversion,
  Zboqheadno,
  Zboqitemno;

  field ( readonly ) CreatedBy, CreatedAt, LastChangedBy, LastChangedAt;

  create;
  update;
  delete;

  //  draft action Edit;
  //  draft action Activate;
  //  draft action Discard;
  //  draft action Resume;
  //  draft determine action Prepare;

  mapping for zpst_boq_mast2
