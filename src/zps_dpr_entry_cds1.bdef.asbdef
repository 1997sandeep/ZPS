      zuom            = zuom;
      zdpr_boq        = zdpr_boq;
      zsubmitted_no   = zsubmitted_no;
      zsubmitted_len  = zsubmitted_len;
      zsubmitted_bre  = zsubmitted_bre;
      zsubmitted_hei  = zsubmitted_hei;
      ztod_qty        = ztod_qty;
      zresource_utl   = zresource_utl;
      zremark         = zremark;
      zappr_status    = zappr_status;
      zpspnr          = zpspnr;
      zproj_ext       = zproj_ext;
      created_by      = created_by;
      created_at      = created_at;
      last_changed_by = last_changed_by;
      last_changed_at = last_changed_at;
      zdpr_from       = zdpr_from;
      zdpr_to         = zdpr_to;
      zdate           = zdate;
      zwo_no          = zwo_no;
      zwo_item        = zwo_item;
      zwo_name        = zwo_name;
      zwo_qty         = zwo_qty;
      zwo_unit        = zwo_unit;
      zmat            = zmat;
      zmat_desc       = zmat_desc;
      zwo_rate        = zwo_rate;
      zwo_amt         = zwo_amt;
      zarea           = zarea;
      ztype_work      = ztype_work;
      zchain_from     = zchain_from;
      zchain_to       = zchain_to;
      zroads          = zroads;
